      "model": "Shader",
      "version": "2.0",
      "pos": [
        0,
        0
      ],
      "data": {
        "layout": 2,
        "inputs": 0,
        "source": "void mainImage(out vec4 color, in vec2 pixel) {\n    vec2 p = (2.0 * pixel - iResolution.xy) / iResolution.y;\n    float ring = smoothstep(0.04, 0.0, abs(length(p) - 0.43));\n    vec3 tint = 0.55 + 0.4 * cos(iTime + vec3(0.0, 2.0, 4.0));\n    color = vec4(vec3(0.025) + ring * tint, 1.0);\n}\n\nvec2 mainSound(int sampleIndex, float seconds) {\n    return 0.18 * sin(6.2831853 * vec2(220.0, 330.0) * seconds);\n}"
      }
    },
